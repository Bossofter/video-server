{
    "name": "video-server",
    "version-string": "1.3.0",
    "description": "Portable C++ video streaming subsystem",
    "dependencies": [
        "gtest",
        {
            "name": "ffmpeg",
            "features": [
                "openh264"
            ]
        },
        {
            "name": "libdatachannel",
            "features": [
                "srtp"
            ]
        },
        "libjuice",
        "openssl",
        "libsrtp",
        "spdlog",
        "tomlplusplus"
    ],
    "features": {
        "vaapi": {
            "description": "Enable VA-API hardware H264 encoding support on Linux",
            "supports": "linux",
            "dependencies": [
                {
                    "name": "ffmpeg",
                    "features": [
                        "vaapi"
                    ],
                    "platform": "linux"
                }
            ]
        }
    }
}
